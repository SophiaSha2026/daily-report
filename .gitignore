__pycache__/
*.pyc
tools/trigger.log
_site/
tools/trigger.log*
.wrangler/
**/.wrangler/
node_modules/
tools/local.env
tools/local_run_*.log
.claude/

# 个人 token，绝不进版本库
.secret
.secret.*

# 回填原始数据：体积大、可重建，不进版本库。
# 派生出来的训练表 data/train/*.parquet 才提交。
cache/hist_daily.parquet
cache/hist_auction.parquet
# out_learn 里只有面板入库：它们要进 Pages 站点，而部署跑在
# 另一个 job 另一次 checkout（历史教训 7：跨 job 传状态要么提交要么
# download-artifact）。其余产物（PDF、brief、race csv）留本地。
# build_site.py 发布哪几个文件，这里就要放行哪几个：council.html 从
# 2026-09-16 上线起被这条规则挡着，git add 返回 rc=1 又被吞掉，
# 「已推送」照打，面板一次都没上过 Pages。
# 2026-09-27 早盘系统归档后这一套搬到 archive/morning/out_learn/，规则跟着搬
archive/morning/out_learn/*
!archive/morning/out_learn/learn.html
!archive/morning/out_learn/council.html

cache/hist_auction_c.parquet
tools/local_flow*.log

# 本机推送状态，控制台总览读它。每次推送都变，进仓库只是噪音
state/push_status.json

# 起涨预测的中间数据。都能从 backfill + build 重新生成，而且很大
# （train.parquet 2.4GB，远超 GitHub 单文件 100MB 的上限）。
# 每日清单 data/breakout/YYYY-MM/breakout_*.parquet 要入库 ——
# 连续天数靠它数，丢了连续计数就断了。
data/breakout/raw/
data/breakout/daily.parquet
data/breakout/train.parquet
data/breakout/holders.parquet
data/breakout/shares.parquet

# 进程锁：本机运行态，不进仓库
state/lock/
# 交易日历缓存，local_run 写、控制台读
state/trade_dates.json

# 学习会诊：CLI 的原始 stream 每份几百 KB，排查用，不进仓库；
# 过程时间线 <lens>.trace.jsonl、结论 <lens>.json、证据包都进（面板和历史靠它们）
archive/morning/state/council/*/*.raw.jsonl
archive/morning/state/council/*/*.raw2.jsonl
# 起涨清单真值（逐只明细，每天重算，能从 daily.parquet 复原）
state/breakout/truth.json

# 端到端运行时测试的报告（tools/e2e_check.py 写），本机跑一次看一次，不进仓库
tools/e2e_report.json

# 注销前导出的计划任务定义（2026-09-27）。带本机用户名和 SID，只留本机，不进公开仓库；
# Morning / Learn 的定义能从 archive/morning/tools/setup_tasks.ps1 原样重建
archive/morning/tools/scheduled_tasks/

# 早盘系统归档时移过来的旧运行日志（原来就是 gitignore 的）
archive/morning/tools/logs/
